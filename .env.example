# --- Supabase / Postgres ---
# From your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key: SERVER-SIDE ONLY. Never expose this to the browser or
# commit it. Used by API routes (collect, and any admin scripts) to bypass
# Row Level Security for writes and for the maintenance script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Collector security ---
# Shared secret the scheduled trigger (GitHub Actions, Vercel Cron, etc.)
# must send as "Authorization: Bearer <value>" to POST /api/collect.
# Generate one with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string

# --- Responsible identification (optional but recommended) ---
# Sent as the User-Agent header on requests to jmu.edu so JMU can identify
# and, if ever needed, contact the operator of this collector.
COLLECTOR_CONTACT_URL=https://github.com/YOUR-USERNAME/jmu-parking-tracker
